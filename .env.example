# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую. Свой ID можно узнать командой /id в этом боте.
ADMIN_IDS=

# Где хранить базу (SQLite)
DB_PATH=data/bot.db

# Чем проверять ответы: groq, openai или heuristic (без ИИ).
# Если не указано: Groq, если задан GROQ_API_KEY, иначе без ИИ.
GRADER=

# Groq (бесплатно): ключ на https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Любой другой OpenAI-совместимый API для GRADER=openai
# (OpenRouter, локальная Ollama: LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=qwen3:8b)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
